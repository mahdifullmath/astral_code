# --- Database ---
DATABASE_URL="postgresql://astral:astral@localhost:5432/astral_code?schema=public"

# --- Auth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — leave blank to hide Google login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (verification / password reset) ---
# Leave blank to log emails to console (dev mode)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Astral Code <no-reply@astralcode.dev>"

# --- Game client API ---
# Master key for Unity/AR clients (server-side only)
GAME_API_MASTER_KEY="change-me-game-api-key"

# --- Coins / anti-cheat ---
DAILY_COIN_CAP_PER_GAME="500"
SESSION_MIN_DURATION_SEC="30"
SESSION_MAX_DURATION_SEC="7200"
